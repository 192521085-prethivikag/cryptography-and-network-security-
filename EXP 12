# Decryption
for i in range(0, len(cipher), 2):
    c1 = ord(cipher[i]) - 65
    c2 = ord(cipher[i+1]) - 65

    p1 = (7*c1 + 22*c2) % 26
    p2 = (21*c1 + 9*c2) % 26

    decrypted += chr(p1 + 65)
    decrypted += chr(p2 + 65)

print("Decrypted Text:", decrypted)
