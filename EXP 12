# Hill Cipher Encryption and Decryption

key = [[9, 4],
       [5, 7]]

text = input("Enter the plaintext: ").upper()

# Remove spaces
plain = ""
for ch in text:
    if ch.isalpha():
        plain += ch

# Add X if odd length
if len(plain) % 2 != 0:
    plain += "X"

cipher = ""

# Encryption
for i in range(0, len(plain), 2):
    p1 = ord(plain[i]) - 65
    p2 = ord(plain[i+1]) - 65

    c1 = (9*p1 + 4*p2) % 26
    c2 = (5*p1 + 7*p2) % 26

    cipher += chr(c1 + 65)
    cipher += chr(c2 + 65)

print("Ciphertext:", cipher)

# Inverse of key matrix
