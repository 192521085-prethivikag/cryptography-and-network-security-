import hashlib
import time

messages = [
    "Hello World",
    "This is a test message",
    "Cryptography is important",
    "Python programming",
    "Secure Hash Algorithm"
]

print("MD5 vs SHA-256")
print("-" * 60)

for message in messages:
    data = message.encode()

    start = time.perf_counter()
    md5_hash = hashlib.md5(data).hexdigest()
    md5_time = time.perf_counter() - start

    start = time.perf_counter()
    sha256_hash = hashlib.sha256(data).hexdigest()
    sha256_time = time.perf_counter() - start

    print("\nMessage:", message)
    print("MD5     :", md5_hash)
    print("SHA-256 :", sha256_hash)
    print("MD5 Time:", md5_time)
    print("SHA-256 Time:", sha256_time)

print("\nCollision Resistance:")
print("MD5 is vulnerable to collision attacks.")
print("SHA-256 provides strong collision resistance.")
print("SHA-256 is recommended for secure applications.")
