plaintext = input("Enter plaintext: ").upper()
a = int(input("Enter value of a: "))
b = int(input("Enter value of b: "))

cipher = ""

for ch in plaintext:
    if ch.isalpha():
        p = ord(ch) - 65
        c = (a * p + b) % 26
        cipher += chr(c + 65)
    else:
        cipher += ch

print("Ciphertext:", cipher)

a_inv = -1
for i in range(26):
    if (a * i) % 26 == 1:
        a_inv = i
        break

if a_inv == -1:
    print("Decryption not possible. 'a' is not valid.")
else:
    plain = ""
    for ch in cipher:
        if ch.isalpha():
            c = ord(ch) - 65
            p = (a_inv * (c - b)) % 26
            plain += chr(p + 65)
        else:
            plain += ch

    print("Decrypted Text:", plain)
