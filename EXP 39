cipher = input("Enter ciphertext: ").upper()
n = int(input("Enter number of possible plaintexts: "))

for key in range(n):
    plain = ""
    for ch in cipher:
        if ch.isalpha():
            p = (ord(ch) - 65 - key) % 26
            plain += chr(p + 65)
        else:
            plain += ch
    print("Key", key, ":", plain)
